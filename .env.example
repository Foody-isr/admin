# foodyadmin environment contract. Copy to .env.local and fill in.

# Foody API base URL (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Guest website origin used by Website V3 links and live preview. When omitted,
# the builder derives the matching dev/prod/local origin from the admin host.
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# Meta Embedded Signup (WhatsApp Tech Provider). These are browser-exposed by design —
# they appear in the FB.login() call. Twilio account credentials are NEVER exposed here.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_WA_CONFIG_ID=
NEXT_PUBLIC_TWILIO_SOLUTION_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=v21.0
# Facebook Login for Business configuration ID that requests the Instagram reels
# scopes (instagram_business_basic). Create it in the same Meta app, then paste here.
NEXT_PUBLIC_META_IG_CONFIG_ID=
