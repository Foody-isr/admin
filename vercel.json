{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "outputDirectory": ".next",
  "alias": ["admin.foody-pos.co.il"],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "github": {
    "silent": false,
    "autoJobCancelation": true
  }
}
